# Kavach — Environment Variables
# Copy this file to .env and fill in values for live LLM mode.
# For scripted-compromised mode, no API key is needed.

# LLM Provider: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# API key for the chosen provider (not needed for ollama)
LLM_API_KEY=your-api-key-here

# Model name (provider-specific)
# gemini: gemini-2.0-flash  |  openai: gpt-4o  |  anthropic: claude-sonnet-4-20250514  |  ollama: llama3
LLM_MODEL=gemini-2.0-flash

# Ollama base URL (only for ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
