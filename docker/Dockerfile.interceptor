# Dockerfile for Kavach Isolated Interceptor Service
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir .

RUN useradd -u 10002 -m kavach-interceptor
USER 10002:10002

ENV PYTHONUNBUFFERED=1
EXPOSE 8100

CMD ["python", "-m", "uvicorn", "kavach.service:app", "--host", "0.0.0.0", "--port", "8100"]
