# Dockerfile for Mock UPI Gateway Service
FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir .

RUN useradd -u 10003 -m kavach-gateway
USER 10003:10003

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "kavach.mock_upi:app", "--host", "0.0.0.0", "--port", "8000"]
